# 네이버 캘린더 연동 설정 (네이버 개발자센터에서 발급)
# https://developers.naver.com/apps/#/register 에서 애플리케이션 등록 후 값 입력

# 애플리케이션 Client ID
NAVER_CLIENT_ID=여기에_클라이언트_ID

# 애플리케이션 Client Secret (절대 외부에 노출 금지)
NAVER_CLIENT_SECRET=여기에_클라이언트_시크릿

# 네이버 앱에 등록한 Callback URL 과 정확히 일치해야 함
# 로컬 개발 예시:
NAVER_CALLBACK_URL=http://localhost:3000/api/naver/callback

# 세션 쿠키 서명용 비밀키 (임의의 긴 랜덤 문자열)
SESSION_SECRET=여기에_충분히_긴_랜덤_문자열

# 서버 포트 (기본 3000)
PORT=3000

# ── 실시간 동기화(Firebase) 설정 ──────────────────────────────
# Firebase 콘솔(https://console.firebase.google.com) → 프로젝트 생성 →
# Realtime Database 생성 + 웹앱 등록 후 아래 값 입력. (클라이언트 공개 설정값)
# 없으면 동기화는 비활성화되고 앱은 로컬 저장으로 정상 동작합니다.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
